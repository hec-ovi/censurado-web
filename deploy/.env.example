# Censurado deploy environment. Copy to deploy/.env and fill in real values.
#   cp deploy/.env.example deploy/.env
# NEVER commit deploy/.env or put real secrets in this example file.

# Absolute origin used to build links in the generated static site and the admin
# regenerate action. Must match where the public site is actually served.
# Example: https://censurado.example
CENSURADO_BASE_URL=https://censurado.example

# Admin operator credentials. Produce a fresh set with:
#   docker compose run --rm admin -gen-credentials
# (or run the admin binary directly with -gen-credentials). It prints, one time:
#   CENSURADO_ADMIN_TOKEN       (the cleartext token; give it to the operator, do
#                                NOT store it on the server)
#   CENSURADO_ADMIN_TOKEN_HASH  (hex sha256 of the token; put it here)
#   CENSURADO_ADMIN_SESSION_KEY (hex, >= 32 bytes; put it here)
# Paste the HASH and SESSION_KEY below. Placeholders are NOT valid; regenerate.
CENSURADO_ADMIN_TOKEN_HASH=replace-with-hex-sha256-from-gen-credentials
CENSURADO_ADMIN_SESSION_KEY=replace-with-hex-session-key-from-gen-credentials

# Set secure cookies on the admin session. Keep true in production (the console is
# reached over HTTPS / an SSH tunnel). Set false only for plain-HTTP local testing.
CENSURADO_ADMIN_SECURE_COOKIES=true

# The publish API authenticates agents against a keys file at deploy/keys.json
# (mounted read-only into the publish container). It carries only secret HASHES,
# never secrets. Seed the file as an empty JSON array FIRST so the bind mount finds
# a file, not a Docker-created empty directory:
#   printf '[]\n' > deploy/keys.json
# Then mint a key (prints the agent TOKEN once, plus the JSON entry) with:
#   docker compose run --rm publish -gen-key -author NAME -scope articles:write
# Put the printed JSON entry into deploy/keys.json (a JSON array, replacing the []),
# and hand the TOKEN to the agent as CENSURADO_PUBLISH_TOKEN. deploy/keys.json is NOT
# a .env var; it is a file. Do not commit it (it is gitignored).
