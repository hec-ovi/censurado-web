# Censurado static-site GENERATOR environment. Copy to deploy/.env and fill in real
# values:
#   cp deploy/.env.example deploy/.env
# NEVER commit deploy/.env or put real secrets in this example file. This repo only
# READS the backend's database and renders the static site; the backend repo owns the
# publish API, the admin console, and its own separate env.

# Path to the backend's sqlite database the generator reads (WAL mode lets it read
# while the backend keeps writing). Required. Flag equivalent: -db.
CENSURADO_DB=/data/censurado.db

# Absolute site origin baked into every generated link, feed, and sitemap, and used to
# join purge URLs into full URLs. Must match where the public site is actually served.
# Required. Flag equivalent: -base-url.
CENSURADO_BASE_URL=https://censurado.example

# CDN purge endpoint invalidated in -watch mode and by the purge command. Leave blank
# for a dry-run purge (no network calls), the safe default. Flag equivalent:
# -purge-endpoint (generate) / -endpoint (purge).
CENSURADO_PURGE_ENDPOINT=

# Secret for the CDN purge, sent as the auth header's value. Read ONLY from this
# variable, never a flag, so it stays out of shell history and ps. Leave blank when
# CENSURADO_PURGE_ENDPOINT is blank (dry run).
CENSURADO_PURGE_TOKEN=

# Name of the auth header the purge secret is sent in. Optional; defaults to
# "Authorization". Set to a vendor-specific header if your CDN needs one.
CENSURADO_PURGE_AUTH_HEADER=Authorization

# Interval between regeneration passes in -watch mode. Optional Go duration; defaults
# to 2s. Flag equivalent: -watch-interval.
CENSURADO_GENERATE_WATCH_INTERVAL=2s

# Purge manifest the standalone purge command reads. Optional; defaults to
# ./public/.generated/purge.json (where the generator writes it). Flag equivalent:
# -file.
CENSURADO_PURGE_FILE=./public/.generated/purge.json
