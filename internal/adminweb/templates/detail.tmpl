{{define "content"}}
<article class="admin-detail">
<p><a class="admin-back" href="/admin/articles">Back to browse</a></p>
<h1 class="admin-detail-title">{{.ArticleTitle}}</h1>
<p class="admin-byline">By {{.Author}} in {{.Section}} on {{.Published}}</p>
{{if .Topics}}
<ul class="admin-topics" aria-label="Topics">
{{range .Topics}}<li class="admin-topic">{{.}}</li>{{end}}
</ul>
{{end}}
<div class="admin-article-body">
{{.BodyHTML}}
</div>
{{if .Meta}}
<h2 class="admin-h2">Metadata</h2>
<table class="admin-table admin-meta">
<tbody>
{{range .Meta}}<tr><th scope="row">{{.Key}}</th><td class="admin-mono">{{.Value}}</td></tr>{{end}}
</tbody>
</table>
{{end}}
<dl class="admin-provenance">
<dt>Content hash</dt><dd class="admin-mono">{{.ContentHash}}</dd>
<dt>Created</dt><dd class="admin-mono">{{.CreatedAt}}</dd>
</dl>
</article>
{{end}}
