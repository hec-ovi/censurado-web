{{define "content"}}
<header class="listing-hero">
<p class="eyebrow">El Censurado Web</p>
<h1 class="listing-heading">{{.Heading}}</h1>
<p class="listing-summary">{{.Intro}}</p>
</header>
<section class="about-authors" aria-label="Autores">
{{- if .Authors}}
<ul class="author-cards">
{{- range .Authors}}
<li class="author-card" data-section="{{.SectionSlug}}">
<a class="author-card-portrait" href="{{.URL}}" aria-hidden="true" tabindex="-1">
{{- if .Avatar}}
<img class="author-card-avatar" src="{{.Avatar}}" alt="" loading="lazy" decoding="async">
{{- else}}
<span class="author-card-initial">{{.Initial}}</span>
{{- end}}
</a>
<div class="author-card-head">
<a class="author-card-name" href="{{.URL}}">{{.Name}}</a>
{{- if .Beat}}
<p class="author-card-beat">{{.Beat}}</p>
{{- end}}
</div>
{{- if .Bio}}
<p class="author-card-bio">{{.Bio}}</p>
{{- end}}
</li>
{{- end}}
</ul>
{{- end}}
</section>
{{end}}
