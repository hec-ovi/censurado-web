{{define "content"}}
<article class="article" data-article>
{{template "lead_media" .}}
<header class="article-header">
<p class="eyebrow">{{.Section}}</p>
<h1 class="article-title">{{.Title}}</h1>
{{- if .Subtitle}}
<p class="article-subtitle">{{.Subtitle}}</p>
{{- end}}
<div class="article-meta">
<p class="byline">Por <a class="author-link" href="{{.AuthorURL}}" rel="author" data-author>{{.AuthorLabel}}</a> en <a class="section-link" href="{{.SectionURL}}" data-section>{{.Section}}</a></p>
</div>
{{template "topic_list" .Topics}}
</header>
{{- if .Standfirst}}
<p class="article-standfirst">{{.Standfirst}}</p>
{{- end}}
<div class="article-shell">
<div class="article-main">
<div class="body article-body">
{{.BodyHTML}}
</div>
<p class="article-date"><time class="published" datetime="{{rfc3339 .PublishedAt}}">{{humandatees .PublishedAt}}</time></p>
<footer class="article-sign">
{{template "author_avatar" .}}
<a class="author-link article-sign-name" href="{{.AuthorURL}}" rel="author" data-author>{{.AuthorLabel}}</a>
</footer>
</div>
<aside class="article-rail author-more" data-author-more="{{.AuthorSlug}}" data-self="{{.Canonical}}" aria-label="Más de este autor">
<h2 class="rail-heading">Más de este autor</h2>
<ol class="author-more-list" data-author-more-list>
{{- range .AuthorMore}}
<li class="author-more-item">
<a class="author-more-link" href="{{.URL}}">
<span class="author-more-section">{{.Section}}</span>
<strong>{{.Title}}</strong>
</a>
</li>
{{- end}}
</ol>
</aside>
</div>
{{- if .Related}}
<section class="related" aria-label="Relacionados">
<h2 class="related-heading">Relacionados</h2>
<ol class="related-list">
{{- range .Related}}
<li class="related-item">{{template "article_card" .}}</li>
{{- end}}
</ol>
</section>
{{- end}}
</article>
{{end}}
