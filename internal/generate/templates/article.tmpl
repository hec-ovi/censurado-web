{{define "content"}}
<article class="article" data-article>
<header class="article-header">
<p class="eyebrow">{{.Section}}</p>
<h1 class="article-title">{{.Title}}</h1>
{{- if .Subtitle}}
<p class="article-subtitle">{{.Subtitle}}</p>
{{- end}}
<time class="article-date" datetime="{{rfc3339 .CreatedAt}}">{{humanstampar .CreatedAt}}</time>
<div class="article-meta">
<p class="byline">Por <a class="author-link" href="{{.AuthorURL}}" rel="author" data-author>{{.AuthorLabel}}</a> en <a class="section-link" href="{{.SectionURL}}" data-section>{{.Section}}</a></p>
</div>
{{template "topic_list" .Topics}}
</header>
{{template "lead_media" .}}
{{- if .Standfirst}}
<p class="article-standfirst">{{.Standfirst}}</p>
{{- end}}
<div class="article-shell">
<div class="article-main">
<div class="body article-body">
{{.BodyHTML}}
</div>
<div class="reactions" data-reactions data-slug="{{.Slug}}" hidden>
<p class="reactions-question">¿Qué te pareció esta nota?</p>
<div class="reactions-buttons">
<button type="button" class="reaction-btn" data-vote="up" aria-pressed="false" aria-label="Me gusta">
<svg class="reaction-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 10h4v11H2zM8 21h9.4a3 3 0 0 0 2.9-2.2l1.6-6A2.5 2.5 0 0 0 19.5 10H14l.9-4.4a2.1 2.1 0 0 0-3.7-1.8L8 10z"/></svg>
<span class="reaction-count" data-count="up">0</span>
</button>
<button type="button" class="reaction-btn" data-vote="down" aria-pressed="false" aria-label="No me gusta">
<svg class="reaction-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 14h-4V3h4zM16 3H6.6a3 3 0 0 0-2.9 2.2l-1.6 6A2.5 2.5 0 0 0 4.5 14H10l-.9 4.4a2.1 2.1 0 0 0 3.7 1.8L16 14z"/></svg>
<span class="reaction-count" data-count="down">0</span>
</button>
</div>
</div>
<footer class="article-sign">
<span class="article-sign-author">
<a class="author-link article-sign-name" href="{{.AuthorURL}}" rel="author" data-author>{{.AuthorLabel}}</a>
{{template "author_avatar" .}}
</span>
</footer>
</div>
<aside class="article-rail author-more" data-author-more="{{.AuthorSlug}}" data-self="{{.Canonical}}" aria-label="Más de este autor">
<h2 class="rail-heading">Más de este autor</h2>
<ol class="author-more-list" data-author-more-list>
{{- range .AuthorMore}}
<li class="author-more-item">
<a class="author-more-link" href="{{.URL}}">
<span class="author-more-section">{{.Section}}</span>
<strong>{{.Title}}</strong>
</a>
</li>
{{- end}}
</ol>
</aside>
</div>
{{- if .Related}}
<section class="related" aria-label="Relacionados">
<h2 class="related-heading">Relacionados</h2>
<ol class="related-list">
{{- range .Related}}
<li class="related-item">{{template "article_card" .}}</li>
{{- end}}
</ol>
</section>
{{- end}}
</article>
{{end}}
