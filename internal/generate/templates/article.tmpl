{{define "content"}}
<article class="article" data-article>
{{template "lead_media" .}}
<header class="article-header">
<p class="eyebrow">{{.Section}}</p>
<h1 class="article-title">{{.Title}}</h1>
{{- if .Subtitle}}
<p class="article-subtitle">{{.Subtitle}}</p>
{{- end}}
<div class="article-meta">
<p class="byline">Por <a class="author-link" href="{{.AuthorURL}}" rel="author" data-author>{{.AuthorLabel}}</a> en <a class="section-link" href="{{.SectionURL}}" data-section>{{.Section}}</a></p>
<time class="published" datetime="{{rfc3339 .PublishedAt}}">{{humandate .PublishedAt}}</time>
</div>
{{template "topic_list" .Topics}}
</header>
{{- if .Standfirst}}
<p class="article-standfirst">{{.Standfirst}}</p>
{{- end}}
<div class="body article-body">
{{.BodyHTML}}
</div>
<footer class="article-sign">
{{template "author_avatar" .}}
<a class="author-link article-sign-name" href="{{.AuthorURL}}" rel="author" data-author>{{.AuthorLabel}}</a>
</footer>
</article>
{{end}}
