{{define "author_avatar"}}
<span class="author-avatar" aria-hidden="true">{{if .AuthorAvatar}}<img src="{{.AuthorAvatar}}" alt="" loading="lazy" decoding="async">{{else}}<span>{{.AuthorInitial}}</span>{{end}}</span>
{{end}}

{{define "topic_list"}}
{{- if .}}
<ul class="topics" data-topics>
{{- range .}}
<li><a class="topic-link" href="{{.URL}}">{{.Label}}</a></li>
{{- end}}
</ul>
{{- end}}
{{end}}

{{define "article_card"}}
{{- $video := or (eq .Thumb.Kind "youtube") (eq .Thumb.Kind "video") -}}
<article class="card{{if .Thumb.Src}} card-has-media{{else}} card-textonly{{end}}{{if $video}} card-has-video{{end}}">
{{- if .Thumb.Src}}
<figure class="card-media"{{if $video}} aria-label="Vídeo: {{.Thumb.Alt}}"{{end}}>
<img src="{{.Thumb.Src}}" alt="{{.Thumb.Alt}}" loading="lazy" decoding="async">
{{- if $video}}
<span class="card-media-play" aria-hidden="true"></span>
{{- end}}
</figure>
{{- end}}
<div class="card-body">
<div class="card-kicker">
<a class="section-link" href="{{.SectionURL}}" data-section>{{.Section}}</a>
<time class="published" datetime="{{rfc3339 .PublishedAt}}">{{humandate .PublishedAt}}</time>
</div>
<h2 class="card-title"><a class="card-link" href="{{.URL}}">{{.Title}}</a></h2>
{{- if .Subtitle}}
<p class="card-subtitle">{{.Subtitle}}</p>
{{- end}}
{{- if .Description}}
<p class="card-description">{{.Description}}</p>
{{- end}}
<div class="card-meta">
{{template "author_avatar" .}}
<p class="byline"><a class="author-link" href="{{.AuthorURL}}" data-author>{{.AuthorLabel}}</a></p>
</div>
</div>
</article>
{{end}}

{{/* lead_card is the full-width lead on a non-author listing: title and dek run
     full width up top, the image floats left, and the summary wraps beside it and
     continues full width below. No .card-body wrapper, so the float lives in the
     card's own block flow. Same hooks as article_card (.card-link, data-author). */}}
{{define "lead_card"}}
{{- $video := or (eq .Thumb.Kind "youtube") (eq .Thumb.Kind "video") -}}
<article class="card lead-card{{if .Thumb.Src}} card-has-media{{else}} card-textonly{{end}}{{if $video}} card-has-video{{end}}">
<div class="card-kicker">
<a class="section-link" href="{{.SectionURL}}" data-section>{{.Section}}</a>
<time class="published" datetime="{{rfc3339 .PublishedAt}}">{{humandate .PublishedAt}}</time>
</div>
<h2 class="card-title"><a class="card-link" href="{{.URL}}">{{.Title}}</a></h2>
<div class="lead-card-body">
<div class="lead-card-text">
{{- if .Subtitle}}
<p class="card-subtitle">{{.Subtitle}}</p>
{{- end}}
{{- if .Description}}
<p class="card-description">{{.Description}}</p>
{{- end}}
<div class="card-meta">
{{template "author_avatar" .}}
<p class="byline"><a class="author-link" href="{{.AuthorURL}}" data-author>{{.AuthorLabel}}</a></p>
</div>
</div>
{{- if .Thumb.Src}}
<figure class="card-media"{{if $video}} aria-label="Vídeo: {{.Thumb.Alt}}"{{end}}>
<img src="{{.Thumb.Src}}" alt="{{.Thumb.Alt}}" loading="lazy" decoding="async">
{{- if $video}}
<span class="card-media-play" aria-hidden="true"></span>
{{- end}}
</figure>
{{- end}}
</div>
</article>
{{end}}
