{{define "author_avatar"}}
<span class="author-avatar" aria-hidden="true">{{if .AuthorAvatar}}<img src="{{.AuthorAvatar}}" alt="" loading="lazy" decoding="async">{{else}}<span>{{.AuthorInitial}}</span>{{end}}</span>
{{end}}

{{define "topic_list"}}
{{- if .}}
<ul class="topics" data-topics>
{{- range .}}
<li><a class="topic-link" href="{{.URL}}">{{.Label}}</a></li>
{{- end}}
</ul>
{{- end}}
{{end}}

{{/* card_inner is the body shared by the portada card and the full-width lead: one
     flex column in a single source order (date, title, media, dek, summary,
     signature). The date always opens the card; on media cards CSS `order` pulls the
     image between the date and the title (see style.css). The signature signs
     Name then portrait (name first, avatar to its right). */}}
{{define "card_inner"}}
{{- $video := or (eq .Thumb.Kind "youtube") (eq .Thumb.Kind "video") -}}
<div class="card-body">
<div class="card-kicker">
<a class="section-link" href="{{.SectionURL}}" data-section>{{.Section}}</a>
<time class="published" datetime="{{rfc3339 .PublishedAt}}">{{humandateart .PublishedAt}}</time>
</div>
<time class="card-date" datetime="{{rfc3339 .CreatedAt}}">{{humanstampar .CreatedAt}}</time>
<h2 class="card-title"><a class="card-link" href="{{.URL}}">{{.Title}}</a></h2>
{{- if .Thumb.Src}}
<figure class="card-media"{{if $video}} aria-label="Vídeo: {{.Thumb.Alt}}"{{end}}>
<img src="{{.Thumb.Src}}" alt="{{.Thumb.Alt}}" loading="lazy" decoding="async">
{{- if $video}}
<span class="card-media-play" aria-hidden="true"></span>
{{- end}}
</figure>
{{- end}}
{{- if .Subtitle}}
<p class="card-subtitle">{{.Subtitle}}</p>
{{- end}}
{{- if .Description}}
<p class="card-description">{{.Description}}</p>
{{- end}}
<div class="card-meta">
<p class="byline"><a class="author-link" href="{{.AuthorURL}}" data-author>{{.AuthorLabel}}</a></p>
{{template "author_avatar" .}}
</div>
<div class="card-share">
<a class="card-share-link share-x" href="https://twitter.com/intent/tweet?text={{urlquery .Title}}&url={{urlquery .Canonical}}" target="_blank" rel="noopener noreferrer" aria-label="Compartir en X">
<svg class="card-share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
</a>
<a class="card-share-link share-whatsapp" href="https://wa.me/?text={{urlquery .Title}}%20{{urlquery .Canonical}}" target="_blank" rel="noopener noreferrer" aria-label="Compartir en WhatsApp">
<svg class="card-share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/></svg>
</a>
<a class="card-share-link share-telegram" href="https://t.me/share/url?url={{urlquery .Canonical}}&text={{urlquery .Title}}" target="_blank" rel="noopener noreferrer" aria-label="Compartir en Telegram">
<svg class="card-share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
</a>
<a class="card-share-link share-linkedin" href="https://www.linkedin.com/sharing/share-offsite/?url={{urlquery .Canonical}}" target="_blank" rel="noopener noreferrer" aria-label="Compartir en LinkedIn">
<svg class="card-share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
</a>
<a class="card-share-link share-facebook" href="https://www.facebook.com/sharer/sharer.php?u={{urlquery .Canonical}}" target="_blank" rel="noopener noreferrer" aria-label="Compartir en Facebook">
<svg class="card-share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
</a>
</div>
</div>
{{end}}

{{define "article_card"}}
{{- $video := or (eq .Thumb.Kind "youtube") (eq .Thumb.Kind "video") -}}
<article class="card{{if .Thumb.Src}} card-has-media{{else}} card-textonly{{end}}{{if $video}} card-has-video{{end}}">{{template "card_inner" .}}</article>
{{end}}

{{/* lead_card is the front page's full-width lead. Same field order as a portada
     card; the CSS gives it a bigger title and a wide full-bleed hero (never the old
     tall side column) and keeps its summary. */}}
{{define "lead_card"}}
{{- $video := or (eq .Thumb.Kind "youtube") (eq .Thumb.Kind "video") -}}
<article class="card lead-card{{if .Thumb.Src}} card-has-media{{else}} card-textonly{{end}}{{if $video}} card-has-video{{end}}">{{template "card_inner" .}}</article>
{{end}}
