{{define "site_header"}}
<header class="site-header" data-site-header>
<div class="masthead">
<div class="masthead-media" data-masthead data-masthead-videos="/assets/video1.mp4 /assets/video3.mp4 /assets/video2.mp4 /assets/video4.mp4" aria-hidden="true">
<video class="masthead-video is-active" muted loop autoplay playsinline preload="auto">
<source src="/assets/video1.mp4" type="video/mp4">
</video>
<video class="masthead-video" muted playsinline preload="auto"></video>
<div class="masthead-scanlines"></div>
</div>
<div class="header-topline">
<button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="primary-nav">{{t "nav.menu_toggle"}}</button>
<div class="theme-switcher" role="group" aria-label="{{t "nav.theme_group_aria"}}">
<button type="button" data-theme-choice="system" aria-pressed="true">{{t "nav.theme_system"}}</button>
<button type="button" data-theme-choice="light" aria-pressed="false">{{t "nav.theme_light"}}</button>
<button type="button" data-theme-choice="dark" aria-pressed="false">{{t "nav.theme_dark"}}</button>
</div>
</div>
<a class="site-name brand-wordmark" href="/latest/" aria-label="{{t "nav.logo_aria"}}">
<span class="brand-word brand-word-el"><span class="brand-el-e">E</span><span class="brand-el-l">L</span></span>
<span class="brand-word brand-word-censurado">censurado</span>
<span class="brand-word brand-word-web">W<span class="brand-e">e</span>b</span>
</a>
<a class="masthead-youtube" href="https://www.youtube.com/@elcensuradoweb" target="_blank" rel="noopener" aria-label="{{t "nav.youtube_aria"}}">
<svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false"><path fill="#FF0000" d="M23.5 6.2a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.51A3.02 3.02 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3.02 3.02 0 0 0 2.12 2.14c1.88.51 9.38.51 9.38.51s7.5 0 9.38-.51a3.02 3.02 0 0 0 2.12-2.14A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8z"/><path fill="#fff" d="M9.55 15.57V8.43L15.82 12z"/></svg>
</a>
</div>
<nav class="site-nav" id="primary-nav" data-nav="primary" data-menu-panel aria-label="{{t "nav.landmark_aria"}}">
{{- range .NavLinks}}
<a class="site-nav-link" href="{{.URL}}">{{.Label}}</a>
{{- else}}
<a class="site-nav-link" href="/latest/">{{t "nav.latest"}}</a>
{{- end}}
</nav>
</header>
{{end}}

{{define "site_footer"}}
<footer class="site-footer" data-site-footer>
<div class="footer-brand">
<p class="footer-name">
<a class="footer-wordmark brand-wordmark" href="/latest/" aria-label="{{t "nav.logo_aria"}}">
<span class="brand-word brand-word-el"><span class="brand-el-e">E</span><span class="brand-el-l">L</span></span>
<span class="brand-word brand-word-censurado">censurado</span>
<span class="brand-word brand-word-web">W<span class="brand-e">e</span>b</span>
</a>
</p>
<p class="site-footer-deck">{{t "footer.tagline"}}</p>
</div>
<section class="footer-disclosure" aria-label="{{t "footer.disclosure_heading"}}">
<h2 class="footer-heading">{{t "footer.disclosure_heading"}}</h2>
<p>{{t "footer.disclosure_body_1"}}</p>
<p>{{t "footer.disclosure_body_2"}}</p>
</section>
</footer>
{{end}}
