{{define "headextra"}}
{{- if .PrevURL}}<link rel="prev" href="{{.PrevURL}}">{{end}}
{{- if .NextURL}}<link rel="next" href="{{.NextURL}}">{{end}}
{{- if .IsLanding}}{{range .FeedLinks}}
<link rel="{{.Rel}}" type="{{.Type}}" href="{{.Href}}" title="{{.Title}}">
{{- end}}{{end}}
{{- end}}
{{define "content"}}
{{- if .AuthorName}}
<section class="author-profile" data-author-profile>
<div class="author-profile-photo">
{{- if .AuthorAvatar}}
<img src="{{.AuthorAvatar}}" alt="" loading="lazy" decoding="async">
{{- else}}
<span class="author-profile-initial" aria-hidden="true">{{.AuthorInitial}}</span>
{{- end}}
</div>
<div class="author-profile-main">
<p class="author-profile-kicker">Perfil</p>
<h1 class="author-profile-name">{{.AuthorName}}</h1>
{{- if .AuthorTopics}}
<nav class="author-profile-topics" aria-label="Temas que cubre">
<p class="author-profile-label">Temas</p>
<ul>
{{- range .AuthorTopics}}
<li><a href="{{.URL}}">{{.Label}}</a></li>
{{- end}}
</ul>
</nav>
{{- end}}
{{- if .AuthorBio}}
<section class="author-profile-about" aria-label="Sobre {{.AuthorName}}">
<p class="author-profile-label">Sobre</p>
<p>{{.AuthorBio}}</p>
</section>
{{- end}}
</div>
</section>
{{- else}}
<header class="listing-hero">
<p class="eyebrow">Portada</p>
<h1 class="listing-heading">{{.Heading}}</h1>
<p class="listing-summary">{{.Description}}</p>
</header>
{{- end}}
<section class="portal-front{{if .AuthorName}} author-portal{{end}}" data-facets aria-label="{{if .AuthorName}}Contenido generado{{else}}Portada{{end}}">
{{- if .AuthorName}}
<header class="author-content-head">
<p class="eyebrow">Contenido generado</p>
<h2>Últimas publicaciones</h2>
</header>
{{- end}}
<ol class="article-list{{if .AuthorName}} author-grid{{end}}" data-articles>
{{- range .Items}}
<li class="article-item" data-author="{{.AuthorSlug}}" data-author-avatar="{{.AuthorAvatar}}" data-section="{{.SectionSlug}}" data-topics="{{.TopicsAttr}}" data-month="{{.MonthSlug}}">
{{template "article_card" .}}
</li>
{{- end}}
</ol>
{{- if .Rail}}
<aside class="ranked-rail" aria-label="Lo más leído">
<h2 class="rail-heading">Lo más leído</h2>
<ol class="ranked-list">
{{- range .Rail}}
<li class="ranked-item">
<a class="ranked-link" href="{{.URL}}">
<span class="ranked-section">{{.Section}}</span>
<strong>{{.Title}}</strong>
</a>
</li>
{{- end}}
</ol>
</aside>
{{- end}}
{{- if gt (len .Pager.Pages) 1}}
<nav class="pager" data-pager aria-label="Páginas">
{{- range .Pager.Pages}}
<a class="pager-link" href="{{.URL}}">{{.N}}</a>
{{- end}}
</nav>
{{- end}}
{{- if .Months}}
<nav class="months" data-months aria-label="Meses">
{{- range .Months}}
<a class="month-link" href="{{.URL}}" data-month="{{.Slug}}">{{.Label}}</a>
{{- end}}
</nav>
{{- end}}
</section>
{{- if .IsLanding}}
{{.Manifest}}
{{- end}}
{{end}}
