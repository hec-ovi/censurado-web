{{define "content"}}
<section class="listing-hero notfound" aria-labelledby="notfound-heading">
<p class="eyebrow">Error 404</p>
<h1 class="listing-heading" id="notfound-heading">{{.Heading}}</h1>
{{- range .Message}}
<p class="listing-summary">{{.}}</p>
{{- end}}
<p class="notfound-actions">
<a class="pager-link" href="{{.HomeURL}}">{{.HomeLabel}}</a>
</p>
</section>
{{end}}
